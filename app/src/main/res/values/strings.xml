    <!-- Setup guide -->
    <string name="guide_title">Setup guide</string>
    <string name="guide_intro">Follow these steps once so FCM push notifications arrive reliably.</string>
    <string name="guide_step1">1. Grant the “Modify system settings” permission.</string>
    <string name="guide_step2">2. Tap “Repair now” once to add Google Play services to the whitelist.</string>
    <string name="guide_step3">3. Enable “Automatic protection”.</string>
    <string name="guide_step4">4. In HyperOS, enable Autostart for FCM Guard and set battery policy to “No restrictions”.</string>
    <string name="guide_step5">5. Keep “Persistent notification” on, and allow notifications if the system blocks them.</string>
    <string name="guide_step6">6. Optional: scan FCM apps and configure any that still deliver late.</string>
